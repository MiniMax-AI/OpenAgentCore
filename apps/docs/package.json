{
  "name": "@oac/docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "dev": "next dev --port 4000",
    "build": "fumadocs-mdx && next build && node scripts/verify-prerender.mjs",
    "api:generate": "node scripts/generate-api-reference.mjs",
    "verify": "pnpm verify:contracts && pnpm verify:routes && pnpm verify:copy && pnpm verify:docs && pnpm verify:links",
    "verify:contracts": "node scripts/verify-contract-freshness.mjs",
    "verify:routes": "node scripts/check-python.mjs routes",
    "verify:copy": "node scripts/verify-api-copy.mjs",
    "verify:docs": "node scripts/verify-docs-facts.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "check:prerender": "node scripts/verify-prerender.mjs",
    "check:site": "node scripts/check-site.mjs",
    "start": "next start",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "test": "node --test && node scripts/check-python.mjs tests",
    "guides:generate": "node scripts/generate-guides.mjs",
    "generate": "pnpm guides:generate && pnpm api:generate",
    "check:browser": "node scripts/check-browser.mjs"
  },
  "dependencies": {
    "@scalar/openapi-upgrader": "0.1.1",
    "fumadocs-core": "15.8.5",
    "fumadocs-mdx": "^12.0.3",
    "fumadocs-openapi": "9.5.1",
    "fumadocs-ui": "15.8.5",
    "js-yaml": "^4.1.0",
    "next": "^15.5.16",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.0",
    "@types/node": "^22.0.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.3"
  }
}
